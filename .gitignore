# Disposable development database state; reports and snapshots are kept
*.sqlite
*.sqlite-wal
*.sqlite-shm
__pycache__/
*.pyc
.DS_Store
# Workbench session tokens exist only while a run is live
artifacts/development/workbench/*/state/fixture.json
artifacts/development/workbench/*/state/*.log
# Local virtual environment for the client and the LangGraph example
.venv/
# Example runs on the everyday interface: tokens and logs exist only while a host is live
artifacts/development/memo_returns/*/state/fixture.json
artifacts/development/memo_returns/*/state/*.log
artifacts/development/memo_returns/*/researcher/checkpoints.sqlite*
